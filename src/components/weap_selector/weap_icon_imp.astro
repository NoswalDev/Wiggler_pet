---
import type { ImageMetadata } from 'astro';
import { Image } from "astro:assets";

interface Props {
  weapName: string;
  weapImgPath: string;
}

const { game, guide, weapName, weapImgPath } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/weap_icons/*.{png,webp}');
---

<Image src={images[weapImgPath]()} alt={weapName} class="BurgerWeaponTableImg center" />